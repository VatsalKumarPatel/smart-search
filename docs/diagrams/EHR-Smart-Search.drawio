<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" compressed="false" version="24.0.0">
  <diagram id="smart-search" name="EHR Smart Search">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;EHR Smart Search - Architecture (.NET 8 + AWS Bedrock + Amazon Transcribe)&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="1200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="lane_ui" value="Browser - EHR MVC UI" style="swimlane;startSize=30;rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="360" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="ui_search" value="&lt;b&gt;Smart Search box&lt;/b&gt;&lt;br&gt;text input + mic button" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="lane_ui">
          <mxGeometry x="20" y="50" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ui_mic" value="&lt;b&gt;Mic capture&lt;/b&gt;&lt;br&gt;AudioWorklet, 16 kHz PCM chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="lane_ui">
          <mxGeometry x="20" y="150" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ui_render" value="&lt;b&gt;Result renderer registry&lt;/b&gt;&lt;br&gt;Panel (1) | Cards (2-6) | List/Table (7+)&lt;br&gt;driven by view model JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="lane_ui">
          <mxGeometry x="20" y="260" width="320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ui_dym" value="&lt;b&gt;Did-you-mean block&lt;/b&gt;&lt;br&gt;No exact match for 'vatsl' - Vatsal Patel? Vatsala Shah?&lt;br&gt;click re-runs search pinned to ClientId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_ui">
          <mxGeometry x="20" y="380" width="320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ui_toggle" value="&lt;b&gt;Layout toggle + click tracking&lt;/b&gt;&lt;br&gt;?src=smartsearch and q={queryId}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="lane_ui">
          <mxGeometry x="20" y="500" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="lane_ss" value="SmartSearch Module (.NET 8 - modular monolith)" style="swimlane;startSize=30;rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="40" width="760" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="ss_hub" value="&lt;b&gt;SpeechHub (SignalR)&lt;/b&gt;&lt;br&gt;streams audio, pushes partial text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="lane_ss">
          <mxGeometry x="20" y="50" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ss_api" value="&lt;b&gt;POST /api/smart-search&lt;/b&gt;&lt;br&gt;JWT, Kernel.Tenancy, rate limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="lane_ss">
          <mxGeometry x="270" y="50" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ss_audit" value="&lt;b&gt;Audit writer&lt;/b&gt;&lt;br&gt;who searched what (HIPAA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="lane_ss">
          <mxGeometry x="520" y="50" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="p1" value="&lt;b&gt;1. Clean text&lt;/b&gt;&lt;br&gt;trim, length cap, source tag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="lane_ss">
          <mxGeometry x="20" y="170" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;2. Extract intent&lt;/b&gt;&lt;br&gt;BedrockIntentClassifier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_ss">
          <mxGeometry x="200" y="170" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;3. Validate&lt;/b&gt;&lt;br&gt;allow-list, slot types, role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="lane_ss">
          <mxGeometry x="380" y="170" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;4. Resolve clients&lt;/b&gt;&lt;br&gt;exact, phonetic, fuzzy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_ss">
          <mxGeometry x="560" y="170" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p5" value="&lt;b&gt;5. Run capabilities&lt;/b&gt;&lt;br&gt;keyed DI, Task.WhenAll" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="lane_ss">
          <mxGeometry x="560" y="290" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p6" value="&lt;b&gt;6. Pick layout&lt;/b&gt;&lt;br&gt;LayoutSelector + ViewTemplate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="lane_ss">
          <mxGeometry x="380" y="290" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p7" value="&lt;b&gt;7. Build links&lt;/b&gt;&lt;br&gt;ILinkProvider + LinkGenerator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="lane_ss">
          <mxGeometry x="200" y="290" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p8" value="&lt;b&gt;8. Compose view model&lt;/b&gt;&lt;br&gt;results + suggestions JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="lane_ss">
          <mxGeometry x="20" y="290" width="160" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="ss_fuzzy" value="&lt;b&gt;NameMatcher (spelling tolerance)&lt;/b&gt;&lt;br&gt;candidates: phonetic key or 2-char prefix&lt;br&gt;rank: Jaro-Winkler + Damerau-Levenshtein&lt;br&gt;score 0.92+ = match, 0.80-0.92 = did you mean" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_ss">
          <mxGeometry x="380" y="410" width="360" height="90" as="geometry"/>
        </mxCell>
